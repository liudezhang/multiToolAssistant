    "vue-router": "^5.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/he": "^1.2.3",
    "@wxt-dev/module-vue": "^1.0.3",
